{
  "name": "qrcanvas-vue",
  "version": "3.1.0",
  "description": "QRCanvas component for Vue.js",
  "author": "Gerald <i@gerald.top>",
  "license": "ISC",
  "scripts": {
    "dev": "vite build --watch",
    "build:types": "tsc",
    "build": "pnpm run clean && vite build && pnpm build:types",
    "deploy": "gh-pages -fd demo",
    "prepublishOnly": "npm run build",
    "clean": "del-cli dist"
  },
  "keywords": [
    "qrcode",
    "qrcanvas",
    "vue"
  ],
  "peerDependencies": {
    "vue": "^3.2"
  },
  "repository": "git@github.com:gera2ld/qrcanvas-vue.git",
  "typings": "dist/index.d.ts",
  "unpkg": "dist/qrcanvas-vue.js",
  "jsdelivr": "dist/qrcanvas-vue.js",
  "main": "dist/qrcanvas-vue.common.js",
  "module": "dist/qrcanvas-vue.esm.js",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "del-cli": "^7.0.0",
    "gh-pages": "^6.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vue": "^3.5.38"
  },
  "dependencies": {
    "qrcanvas": "^3.1.2"
  }
}
